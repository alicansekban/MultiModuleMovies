
# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

default_platform(:android)

platform :android do
  desc "Run lint checks"
  lane :checks do
    gradle(task: "lint")
  end

  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Alias for test lane"
  lane :tests do
    test
  end

  desc "Build signed APK release"
  lane :apk_release do
    environment = ENV["BUILD_ENVIRONMENT"] || "prod"
    build_type = ENV["BUILD_TYPE"] || "release"

    task = "clean assemble#{environment.capitalize}#{build_type.capitalize}"

    UI.message "🔨 Building: #{task}"
    UI.message "📦 Environment: #{environment}"
    UI.message "🏗️  Build Type: #{build_type}"

    gradle_properties = {}

    if build_type.downcase == "release"
      # Verify keystore exists before adding signing properties
      keystore_path = ENV["ANDROID_KEYSTORE_PATH"] || "./keystore.jks"
      unless File.exist?(keystore_path)
        UI.user_error!("Keystore not found at: #{keystore_path}. Make sure keystore is decoded for release builds.")
      end

      UI.message "🔐 Using keystore: #{keystore_path}"

      # Add signing properties for release builds
      gradle_properties = {
        "RELEASE_STORE_FILE" => ENV["RELEASE_STORE_FILE"] || "keystore.jks",
        "RELEASE_STORE_PASSWORD" => ENV["RELEASE_STORE_PASSWORD"],
        "RELEASE_KEY_ALIAS" => ENV["RELEASE_KEY_ALIAS"],
        "RELEASE_KEY_PASSWORD" => ENV["RELEASE_KEY_PASSWORD"]
      }
    else
      UI.message "🔧 Building debug version - no signing required"
    end

    gradle(
      task: task,
      properties: gradle_properties
    )
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    upload_to_play_store
  end
end