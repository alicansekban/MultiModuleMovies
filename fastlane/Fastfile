
# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

default_platform(:android)

platform :android do
  desc "Run lint checks"
  lane :checks do
    gradle(task: "lint")
  end

  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Alias for test lane"
  lane :tests do
    test
  end

  desc "Build signed APK release"
  lane :apk_release do
    environment = ENV["BUILD_ENVIRONMENT"] || "prod"
    build_type = ENV["BUILD_TYPE"] || "release"

    task = "clean assemble#{environment.capitalize}#{build_type.capitalize}"

    UI.message "🔨 Building: #{task}"
    UI.message "📦 Environment: #{environment}"
    UI.message "🏗️  Build Type: #{build_type}"

    # Check if we have the keystore.jks in the repository
    repo_keystore = "./keystore.jks"
    if File.exist?(repo_keystore)
      UI.message "🔐 Using repository keystore: #{repo_keystore}"

      gradle(
        task: task,
        properties: {
          "RELEASE_STORE_FILE" => "keystore.jks",
          "RELEASE_STORE_PASSWORD" => ENV["RELEASE_STORE_PASSWORD"],
          "RELEASE_KEY_ALIAS" => ENV["RELEASE_KEY_ALIAS"],
          "RELEASE_KEY_PASSWORD" => ENV["RELEASE_KEY_PASSWORD"]
        }
      )
    else
      # For debug builds or when no keystore is needed
      UI.message "🔧 Building without signing (debug or no keystore available)"
      gradle(task: task)
    end
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    upload_to_play_store
  end
end