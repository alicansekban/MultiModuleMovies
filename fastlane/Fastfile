
# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

default_platform(:android)

platform :android do
  desc "Run lint checks"
  lane :checks do
    gradle(task: "lint")
  end

  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Alias for test lane"
  lane :tests do
    test
  end

  desc "Build signed APK release"
  lane :apk_release do
    environment = ENV["BUILD_ENVIRONMENT"] || "prod"
    build_type = ENV["BUILD_TYPE"] || "release"
    
    task = "clean assemble#{environment.capitalize}#{build_type.capitalize}"
    
    if build_type == "release"
      gradle(
        task: task,
        properties: {
          "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
          "android.injected.signing.store.password" => ENV["RELEASE_STORE_PASSWORD"],
          "android.injected.signing.key.alias" => ENV["RELEASE_KEY_ALIAS"],
          "android.injected.signing.key.password" => ENV["RELEASE_KEY_PASSWORD"]
        }
      )
    else
      gradle(task: task)
    end
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    upload_to_play_store
  end
end